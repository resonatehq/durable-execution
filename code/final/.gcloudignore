# What the build does not need. The suite, its fixtures and its caches are
# not part of the service, and uploading them makes a slower build and a
# larger image for no benefit.
.git/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.mypy_cache/
test/
requirements-dev.txt
live/
examples/

# What IS uploaded: `main.py`, the `resonate/` package beside it, and
# `requirements.txt`. The package is a sibling rather than an installed
# distribution here, which is what makes `--source .` deploy this
# repository's own example; a user installs it and uploads one file.
